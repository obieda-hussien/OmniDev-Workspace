<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Official Termux third-party command API. User must still grant this
         permission and set allow-external-apps=true inside Termux. -->
    <uses-permission android:name="com.termux.permission.RUN_COMMAND" />

    <queries>
        <package android:name="com.termux" />
    </queries>

    <application tools:ignore="MissingApplicationIcon">
        <service
            android:name=".data.background.BackgroundAgentService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="User-initiated long-running AI chat and agent execution with live progress and crash recovery" />
        </service>

        <receiver
            android:name=".data.tools.TermuxResultReceiver"
            android:exported="false" />
    </application>

</manifest>
<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:sharedUserId="android.uid.system"
    tools:ignore="SharedUserId">

    <uses-permission android:name="moe.shizuku.manager.permission.API_V23" tools:node="remove" />
    <uses-permission android:name="com.termux.permission.RUN_COMMAND" />

    <queries>
        <package android:name="com.termux" />
    </queries>

    <application>
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            tools:node="remove" />

        <service
            android:name=".data.background.BackgroundAgentService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="User-initiated long-running AI chat and agent execution with live progress and crash recovery" />
        </service>

        <receiver
            android:name=".data.tools.TermuxResultReceiver"
            android:exported="false" />
    </application>

</manifest>